FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HCB_STYLE_EXPERIMENT_ROOT=/data/style-experiments

WORKDIR /app

COPY requirements-style-api.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -r requirements-style-api.txt

COPY api ./api
COPY tools ./tools

RUN mkdir -p /data/style-experiments \
    && useradd --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /app /data

USER appuser

EXPOSE 8000

CMD ["sh", "-c", "uvicorn api.app.style_api:app --host 0.0.0.0 --port ${PORT:-8000}"]
