{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/style_experiment_intake.schema.json",
  "title": "Governed Style Experiment Intake Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "protocol_version",
    "research_question",
    "participants",
    "samples",
    "claim_boundary",
    "publication_posture"
  ],
  "properties": {
    "experiment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "protocol_version": {"type": "string", "const": "hil-style-1.0"},
    "research_question": {"type": "string", "minLength": 20, "maxLength": 2000},
    "participants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_participant_id", "model_systems"],
      "properties": {
        "human_participant_id": {"type": "string", "minLength": 1},
        "model_systems": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "model_family", "model_version"],
            "properties": {
              "provider": {"type": "string", "minLength": 1},
              "model_family": {"type": "string", "minLength": 1},
              "model_version": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_id", "phase", "text_path", "receipt_path", "model_family"],
        "properties": {
          "sample_id": {"type": "string", "minLength": 1},
          "phase": {
            "type": "string",
            "enum": ["baseline", "post_revision", "followup"]
          },
          "text_path": {"type": "string", "minLength": 1},
          "receipt_path": {"type": "string", "minLength": 1},
          "model_family": {"type": "string", "minLength": 1},
          "human_revision_applied": {"type": "boolean", "default": false}
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_claim", "origin_attribution_prohibited", "causation_claim_prohibited"],
      "properties": {
        "maximum_claim": {"type": "string", "const": "observed association between interaction and classifier reliability"},
        "origin_attribution_prohibited": {"type": "boolean", "const": true},
        "causation_claim_prohibited": {"type": "boolean", "const": true}
      }
    },
    "publication_posture": {
      "type": "string",
      "enum": ["private", "reviewable", "public"]
    }
  }
}
