{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/smallest_interoperable_handoff.schema.json",
  "title": "Smallest Interoperable Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "originating_layer",
    "intent",
    "evidence_references",
    "reasoning_summary",
    "uncertainty",
    "unresolved_dependencies",
    "provenance",
    "withheld_claims"
  ],
  "properties": {
    "schema_version": {"const": "SIH-v1"},
    "handoff_id": {"type": "string", "pattern": "^SIH-[A-Z0-9._-]+$"},
    "originating_layer": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1},
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "claim_supported"],
        "properties": {
          "reference": {"type": "string", "minLength": 1},
          "claim_supported": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "reasoning_summary": {"type": "string", "minLength": 1},
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "basis"],
      "properties": {
        "level": {"enum": ["low", "medium", "high", "unknown"]},
        "basis": {"type": "string", "minLength": 1}
      }
    },
    "unresolved_dependencies": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recorded_at", "actor", "source_system"],
      "properties": {
        "recorded_at": {"type": "string", "format": "date-time"},
        "actor": {"type": "string", "minLength": 1},
        "source_system": {"type": "string", "minLength": 1},
        "trace_reference": {"type": "string", "minLength": 1}
      }
    },
    "withheld_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consent", "authority", "admissibility", "commitment", "execution_status"],
      "properties": {
        "consent": {"const": "UNRESOLVED"},
        "authority": {"const": "UNRESOLVED"},
        "admissibility": {"const": "UNRESOLVED"},
        "commitment": {"const": "UNRESOLVED"},
        "execution_status": {"const": "UNRESOLVED"}
      }
    }
  }
}
