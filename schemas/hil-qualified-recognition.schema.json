{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/hil-qualified-recognition.schema.json",
  "title": "HIL Qualified Recognition Candidate Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "trace_id",
    "capability_id",
    "status",
    "contributor",
    "contribution",
    "qualified_examination",
    "causal_effect",
    "attribution",
    "consent_posture",
    "standing_transition",
    "scope_boundary",
    "replay",
    "admission",
    "custody"
  ],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "capability_id": {"const": "HIL-QRL-001"},
    "status": {
      "enum": [
        "candidate",
        "pending_validation",
        "pending_admission",
        "admitted",
        "denied",
        "superseded"
      ]
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participant_ref", "identity_verification_posture"],
      "properties": {
        "participant_ref": {"type": "string", "minLength": 1},
        "identity_verification_posture": {
          "enum": ["unverified", "self_asserted", "platform_observed", "independently_verified"]
        }
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contribution_ref", "description", "evidence_refs"],
      "properties": {
        "contribution_ref": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "digest": {"type": ["string", "null"]},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "qualified_examination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reconstruction_statement", "qualification_basis", "evidence_refs"],
      "properties": {
        "reconstruction_statement": {"type": "string", "minLength": 1},
        "qualification_basis": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "causal_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_ref", "material_effect", "bounded_claim", "reconstructable", "evidence_refs"],
      "properties": {
        "result_ref": {"type": "string", "minLength": 1},
        "material_effect": {"type": "boolean"},
        "bounded_claim": {"type": "string", "minLength": 1},
        "reconstructable": {"type": "boolean"},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserved", "attribution_ref"],
      "properties": {
        "preserved": {"type": "boolean"},
        "attribution_ref": {"type": "string", "minLength": 1}
      }
    },
    "consent_posture": {
      "enum": ["unknown", "observation_only", "attribution_allowed", "research_use_allowed", "publication_allowed", "withdrawn"]
    },
    "standing_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prior", "proposed", "scope"],
      "properties": {
        "prior": {"enum": ["observer", "contributor_candidate", "recognized_contributor", "continuing_participant", "reviewer_candidate"]},
        "proposed": {"enum": ["observer", "contributor_candidate", "recognized_contributor", "continuing_participant", "reviewer_candidate"]},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "scope_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representative_authority_claimed", "execution_authority_claimed", "publication_authority_claimed", "final_admissibility_claimed"],
      "properties": {
        "representative_authority_claimed": {"const": false},
        "execution_authority_claimed": {"const": false},
        "publication_authority_claimed": {"const": false},
        "final_admissibility_claimed": {"const": false}
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_refs", "deterministic_profile"],
      "properties": {
        "input_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "deterministic_profile": {"type": "string", "minLength": 1}
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "decision_ref"],
      "properties": {
        "state": {"enum": ["not_requested", "pending", "ALLOW", "DENY", "ERROR"]},
        "decision_ref": {"type": ["string", "null"]}
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "receipt_ref"],
      "properties": {
        "destination": {"type": ["string", "null"]},
        "receipt_ref": {"type": ["string", "null"]}
      }
    }
  }
}
