{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stegverse.hybrid-collab.ecosystem-chat-external-inference-session.v1",
  "title": "Ecosystem Chat external inference evidence session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "session_id",
    "node_id",
    "receipt_1_sha256",
    "prompt_sha256",
    "observations",
    "authority_effect"
  ],
  "properties": {
    "schema": {
      "const": "stegverse.hybrid-collab.ecosystem-chat-external-inference-session/v1"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "receipt_1_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_id",
          "provider",
          "model",
          "request_correlation",
          "response_sha256",
          "observation_state",
          "authority_effect",
          "capability_id",
          "work_class",
          "input_media",
          "output_media"
        ],
        "properties": {
          "observation_id": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "request_correlation": {
            "type": "string",
            "minLength": 1
          },
          "response_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "observation_state": {
            "enum": [
              "RETAINED",
              "FAILED",
              "INDETERMINATE"
            ]
          },
          "authority_effect": {
            "const": "NONE"
          },
          "capability_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "work_class": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "text",
              "reasoning",
              "code",
              "image",
              "video",
              "audio",
              "science",
              "research",
              "data",
              "other",
              null
            ]
          },
          "input_media": {
            "type": "array",
            "items": {
              "enum": [
                "text",
                "code",
                "image",
                "video",
                "audio",
                "structured_data",
                "binary",
                "other"
              ]
            },
            "default": []
          },
          "output_media": {
            "type": "array",
            "items": {
              "enum": [
                "text",
                "code",
                "image",
                "video",
                "audio",
                "structured_data",
                "binary",
                "other"
              ]
            },
            "default": []
          }
        }
      }
    },
    "authority_effect": {
      "const": "NONE"
    }
  }
}
